// Daymark — Make Every Day Count.
//
// Tenancy model
//  * `User` is a global *identity* (owned by Better Auth). It has no organization.
//  * `Membership` ties a User to an Organization with a role. A user can have
//    several memberships in future (multi-organization) without schema changes.
//  * Every domain row carries `organizationId`. Cross-table references use
//    composite foreign keys (id, organizationId) so the database itself rejects
//    a row in organization A pointing at a row in organization B.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  compilerBuild = "small"
}

datasource db {
  provider = "sqlite"
}

/// How much of the company a person may read beyond their own reporting line (peers, department, everyone).
enum VisibilityScope {
  OWN
  TEAM
  DEPARTMENT
  COMPANY
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum MemberStatus {
  ACTIVE
  DEACTIVATED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum UpdateStatus {
  DRAFT
  SUBMITTED
  EDITED
}

// Where an update came from. Every channel writes the same DailyUpdate record.
enum UpdateSource {
  DASHBOARD
  SLACK
  EMAIL
  WHATSAPP
  EXTERNAL_FORM
}

enum UpdateSection {
  WORKED_ON
  COMPLETED
  PENDING
  BLOCKER
  NEXT_PRIORITY
}

enum RevisionKind {
  SUBMITTED
  EDITED
}

// ───────────────────────── Identity (Better Auth) ─────────────────────────

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Credentials (hashed password) live here, never in ordinary application tables.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Better Auth's built-in rate limiter, stored in the database so limits hold
// across serverless instances (Vercel).
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// Small fixed-window limiter for Daymark's own public endpoints.
model RequestThrottle {
  key         String   @id
  count       Int
  windowStart DateTime
}

// ───────────────────────── Organizations ─────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  timezone  String   @default("UTC")
  // Reserved for future subscription plans. No billing logic in the MVP.
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settings    OrgSettings?
  departments Department[]
  teams       Team[]
  memberships Membership[]
  invitations Invitation[]
  teamAccess  ManagerTeamAccess[]
  auditLogs   AuditLog[]
  dailyUpdates DailyUpdate[]
  objectives   Objective[]
  keyResults   KeyResult[]
  keyResultCheckIns KeyResultCheckIn[]
  workTasks    WorkTask[]
  automationFlows      AutomationFlow[]
  integrationEvents    IntegrationEvent[]
  integrationDeliveries IntegrationDelivery[]
  integrationAttempts  IntegrationAttempt[]
}

model OrgSettings {
  organizationId  String       @id
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Local time (organization timezone) after which a daily update is considered late.
  updateCutoffTime String      @default("18:00")
  // Hours after submission during which an employee may edit their update.
  editWindowHours  Int         @default(24)
  // ISO weekdays 1 (Mon) … 7 (Sun) on which updates are expected, comma-separated ("1,2,3,4,5").
  // Read/write through src/lib/working-days.ts (SQLite has no list columns).
  workingDays      String      @default("1,2,3,4,5")
  aiEnabled        Boolean     @default(true)
  // Transparency: who may read other people's submitted updates. OWN = only your reporting line (privacy-first default).
  visibilityScope  VisibilityScope @default(OWN)
  // Blockers are the most sensitive part of an update: peers only see them when this is on.
  peersSeeBlockers Boolean     @default(false)
  // Automations (viaSocket): admins always have access; managers only when this is on.
  automationsManagerAccess     Boolean @default(false)
  // Off by default: blocker free-text is only sent to automations if the company opts in.
  automationsIncludeBlockerText Boolean @default(false)
  updatedAt        DateTime    @updatedAt
}

model Department {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime     @default(now())

  teams   Team[]
  members Membership[]
  objectives Objective[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departmentId   String?
  department     Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  name           String
  managerId      String?
  manager        Membership?  @relation("TeamManager", fields: [managerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt      DateTime     @default(now())

  members      Membership[]        @relation("MemberTeam")
  accessGrants ManagerTeamAccess[]
  objectives   Objective[]

  @@unique([id, organizationId])
  @@unique([organizationId, name])
  @@index([organizationId, managerId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role
  status         MemberStatus @default(ACTIVE)
  jobTitle       String?
  departmentId   String?
  department     Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  teamId         String?
  team           Team?        @relation("MemberTeam", fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  managerId      String?
  manager        Membership?  @relation("Manager", fields: [managerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  // Seniority/grade (1 = most senior is not assumed: any whole number; used to group "same level" comparisons).
  level          Int?
  // Optional mentor: another person in the same organization.
  mentorId       String?
  mentor         Membership?  @relation("Mentor", fields: [mentorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deactivatedAt  DateTime?

  directReports Membership[]        @relation("Manager")
  mentees       Membership[]        @relation("Mentor")
  ownedObjectives   Objective[]     @relation("ObjectiveOwner")
  createdObjectives Objective[]     @relation("ObjectiveCreator")
  ownedKeyResults   KeyResult[]     @relation("KeyResultOwner")
  checkIns          KeyResultCheckIn[]
  assignedTasks     WorkTask[]      @relation("TaskAssignee")
  createdTasks      WorkTask[]      @relation("TaskCreator")
  managedTeams  Team[]              @relation("TeamManager")
  teamAccess    ManagerTeamAccess[]
  invitationsSent Invitation[]
  dailyUpdates  DailyUpdate[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, teamId])
  @@index([organizationId, managerId])
  @@index([organizationId, mentorId])
  @@index([organizationId, departmentId])
  @@index([userId])
}

// Explicit extra access: a manager may be authorized to view teams they do not
// manage directly. Managers never see anything outside their scope otherwise.
model ManagerTeamAccess {
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Cascade)
  teamId         String
  team           Team         @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([membershipId, teamId])
  @@index([organizationId, teamId])
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           Role
  departmentId   String?
  teamId         String?
  managerId      String?
  // SHA-256 of the invitation token. The raw token is only ever in the link.
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  invitedById    String
  invitedBy      Membership       @relation(fields: [invitedById, organizationId], references: [id, organizationId], onDelete: Restrict)
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  @@index([organizationId, status])
  @@index([organizationId, email])
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Acting user (identity). Kept even if the membership is later deactivated.
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}


// ───────────────────────── Daily updates ─────────────────────────

/// One update per person per day. Content lives in UpdateItem rows (one or more
/// natural-language entries per section) so a single paragraph and a long list are
/// both valid, and later channels (Slack/email/…) can fill the same structure.
model DailyUpdate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     Membership   @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  /// Calendar day the update is about (in the organization's timezone), as "YYYY-MM-DD".
  updateDate     String
  status         UpdateStatus @default(DRAFT)
  source         UpdateSource @default(DASHBOARD)
  /// Denormalized from BLOCKER items for fast manager filtering. Kept in sync by the service.
  hasBlockers    Boolean      @default(false)
  /// The ORIGINAL submission time. Never overwritten by later edits.
  firstSubmittedAt DateTime?
  /// Was the original submission after the day's cut-off? Fixed at first submission.
  submittedLate  Boolean      @default(false)
  lastEditedAt   DateTime?
  /// Number of revisions recorded so far (0 while a draft).
  revisionCount  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items       UpdateItem[]
  attachments UpdateAttachment[]
  goalLinks   UpdateGoalLink[]
  revisions   UpdateRevision[]

  @@unique([membershipId, updateDate])
  @@unique([id, organizationId])
  @@index([organizationId, updateDate])
  @@index([organizationId, membershipId, updateDate])
  @@index([organizationId, updateDate, status])
}

model UpdateItem {
  id             String        @id @default(cuid())
  organizationId String
  dailyUpdateId  String
  dailyUpdate    DailyUpdate   @relation(fields: [dailyUpdateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  section        UpdateSection
  position       Int
  text           String

  @@index([dailyUpdateId, section, position])
  @@index([organizationId, section])
}

/// MVP supports links only; file uploads can reuse this table later (file reference + name).
model UpdateAttachment {
  id             String      @id @default(cuid())
  organizationId String
  dailyUpdateId  String
  dailyUpdate    DailyUpdate @relation(fields: [dailyUpdateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  position       Int
  url            String
  label          String?

  @@index([dailyUpdateId, position])
}

/// Append-only history. `statusAtTime` and `snapshot` preserve exactly what was
/// submitted (revision 1 is the original submission) even after later edits.
model UpdateRevision {
  id             String       @id @default(cuid())
  organizationId String
  dailyUpdateId  String
  dailyUpdate    DailyUpdate  @relation(fields: [dailyUpdateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revisionNumber Int
  kind           RevisionKind
  statusAtTime   UpdateStatus
  changedByUserId String
  snapshot       Json
  createdAt      DateTime     @default(now())

  @@unique([dailyUpdateId, revisionNumber])
  @@index([organizationId, createdAt])
}


// ───────────────────────── Automations (viaSocket, outbound events) ─────────────────────────

enum IntegrationEventType {
  UPDATE_SUBMITTED
  UPDATE_BLOCKER_REPORTED
  UPDATE_MISSING
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

enum AttemptOutcome {
  SUCCESS
  RETRYABLE_ERROR
  PERMANENT_ERROR
}

/// A viaSocket flow created by an organization's admin in the embedded UI. Its run URL is a
/// credential (it runs the organization's connected apps), so it is stored encrypted and never
/// sent to the browser. The table is a cache of what viaSocket lists plus the Daymark event the
/// flow is linked to (chosen explicitly by an admin).
model AutomationFlow {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// HMAC of the viaSocket flow id: lets us match listFlows() entries without storing the id in clear.
  flowKey        String
  /// AES-256-GCM(flow run URL).
  urlEnc         String
  title          String
  description    String?
  /// active | paused | deleted | unknown (as listed by viaSocket).
  status         String
  eventType      IntegrationEventType?
  lastSyncedAt   DateTime              @default(now())
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  deliveries IntegrationDelivery[]

  @@unique([organizationId, flowKey])
  @@unique([id, organizationId])
  @@index([organizationId, eventType, status])
}

/// One logical event. `eventId` is deterministic (hash of organization + eventKey), so the same
/// event always has the same ID — even if the row is ever re-created — and flows can dedupe on it.
model IntegrationEvent {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  eventKey       String
  type           IntegrationEventType
  isTest         Boolean              @default(false)
  /// Minimal payload sent to flows. Cleared after 30 days; the row (and its history) after 180.
  payload        Json?
  createdAt      DateTime             @default(now())

  deliveries IntegrationDelivery[]

  @@unique([organizationId, eventKey])
  @@unique([id, organizationId])
  @@unique([eventId])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

/// One event to one flow. Unique per (event, flow), so duplicate emission can never double-queue.
model IntegrationDelivery {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integrationEventId String
  event            IntegrationEvent @relation(fields: [integrationEventId, organizationId], references: [id, organizationId], onDelete: Cascade)
  automationFlowId String
  flow             AutomationFlow @relation(fields: [automationFlowId, organizationId], references: [id, organizationId], onDelete: Restrict)
  status           DeliveryStatus @default(PENDING)
  attemptCount     Int            @default(0)
  nextAttemptAt    DateTime       @default(now())
  /// Claim lease: another worker will not pick the row up until this passes.
  lockedUntil      DateTime?
  lastHttpStatus   Int?
  lastError        String?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  attempts IntegrationAttempt[]

  @@unique([integrationEventId, automationFlowId])
  @@unique([id, organizationId])
  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
}

/// Append-only retry history: one row per HTTP attempt. Never stores URLs, payloads or response bodies.
model IntegrationAttempt {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryId     String
  delivery       IntegrationDelivery @relation(fields: [deliveryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  attemptNumber  Int
  startedAt      DateTime            @default(now())
  durationMs     Int
  outcome        AttemptOutcome
  httpStatus     Int?
  errorCode      String?
  errorMessage   String?

  @@unique([deliveryId, attemptNumber])
  @@index([organizationId, startedAt])
}

/// Named lease used to keep scheduled jobs from overlapping (replaces PostgreSQL advisory locks).
/// A holder owns the row until `lockedUntil`; an expired lease can be taken over, so a crashed run never blocks forever.
model JobLock {
  name        String   @id
  owner       String
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt
}

// ───────────────────────── Goals: objectives, key results, KPIs, tasks ─────────────────────────
// Objectives cascade: a company objective has department/team/individual objectives under it (`parentId`).
// Everything is tenant-scoped with composite foreign keys, like the rest of the model.

enum ObjectiveLevel {
  COMPANY
  DEPARTMENT
  TEAM
  INDIVIDUAL
}

enum ObjectiveStatus {
  ACTIVE
  DONE
  CANCELLED
}

enum Confidence {
  ON_TRACK
  AT_RISK
  OFF_TRACK
}

enum KeyResultType {
  NUMBER
  PERCENT
  BOOLEAN
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Objective {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  level          ObjectiveLevel
  ownerId        String
  owner          Membership      @relation("ObjectiveOwner", fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  departmentId   String?
  department     Department?     @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  teamId         String?
  team           Team?           @relation(fields: [teamId, organizationId], references: [id, organizationId], onDelete: Restrict)
  parentId       String?
  parent         Objective?      @relation("ObjectiveTree", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children       Objective[]     @relation("ObjectiveTree")
  title          String
  description    String?
  /// "YYYY-MM-DD" in the organization's calendar.
  periodStart    String
  periodEnd      String
  status         ObjectiveStatus @default(ACTIVE)
  createdById    String
  createdBy      Membership      @relation("ObjectiveCreator", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  keyResults KeyResult[]
  tasks      WorkTask[]
  updateLinks UpdateGoalLink[]

  @@unique([id, organizationId])
  @@index([organizationId, periodStart, periodEnd])
  @@index([organizationId, ownerId])
  @@index([organizationId, parentId])
  @@index([organizationId, level])
}

model KeyResult {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectiveId    String
  objective      Objective     @relation(fields: [objectiveId, organizationId], references: [id, organizationId], onDelete: Cascade)
  ownerId        String
  owner          Membership    @relation("KeyResultOwner", fields: [ownerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  title          String
  type           KeyResultType @default(NUMBER)
  startValue     Float         @default(0)
  targetValue    Float
  currentValue   Float         @default(0)
  unit           String?
  /// A KPI is an ongoing indicator that is read repeatedly (revenue, uptime…); the check-in history is its time series.
  isKpi          Boolean       @default(false)
  weight         Int           @default(1)
  confidence     Confidence    @default(ON_TRACK)
  lastCheckInAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  checkIns KeyResultCheckIn[]
  tasks    WorkTask[]

  @@unique([id, organizationId])
  @@index([organizationId, objectiveId])
  @@index([organizationId, ownerId])
}

/// Append-only: every progress reading is kept, so progress and KPI trends have a history.
model KeyResultCheckIn {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  keyResultId    String
  keyResult      KeyResult    @relation(fields: [keyResultId, organizationId], references: [id, organizationId], onDelete: Cascade)
  authorId       String
  author         Membership   @relation(fields: [authorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  value          Float
  confidence     Confidence
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([keyResultId, createdAt])
  @@index([organizationId, createdAt])
}

model WorkTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  objectiveId    String
  objective      Objective    @relation(fields: [objectiveId, organizationId], references: [id, organizationId], onDelete: Cascade)
  keyResultId    String?
  keyResult      KeyResult?   @relation(fields: [keyResultId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assigneeId     String
  assignee       Membership   @relation("TaskAssignee", fields: [assigneeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdById    String
  createdBy      Membership   @relation("TaskCreator", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  title          String
  status         TaskStatus   @default(TODO)
  /// "YYYY-MM-DD"
  dueDate        String?
  doneAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([id, organizationId])
  @@index([organizationId, objectiveId])
  @@index([organizationId, assigneeId, status])
}

/// "This update contributes to that goal": connects daily work to the objective tree so progress is measurable.
model UpdateGoalLink {
  id             String      @id @default(cuid())
  organizationId String
  dailyUpdateId  String
  dailyUpdate    DailyUpdate @relation(fields: [dailyUpdateId, organizationId], references: [id, organizationId], onDelete: Cascade)
  objectiveId    String
  objective      Objective   @relation(fields: [objectiveId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdAt      DateTime    @default(now())

  @@unique([dailyUpdateId, objectiveId])
  @@index([organizationId, objectiveId])
}
