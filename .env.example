# ── Database (SQLite) ───────────────────────────────────────────────────
# Daymark stores everything in one SQLite file. By default it is $DATA_DIR/daymark.db
# (on Embarko, DATA_DIR is set for you and survives redeploys). For a local run:
# DATABASE_URL="file:./data/daymark.db"
# DATA_DIR="./data"

# ── Authentication (Better Auth) ────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (SMTP) — optional ─────────────────────────────────────────────
# Without SMTP, invitation links are shown to the admin to copy and send
# manually, and "Forgot password" reports that email is not configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Daymark <no-reply@example.com>"

# ── AI summaries / weekly reports — optional ───────────────────────────
# Off until a key is set AND an admin enables AI in Settings.
# AI_PROVIDER="anthropic"   # anthropic | openai
# AI_MODEL=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""

# ── Backups (Embarko) ───────────────────────────────────────────────────
# ≥32 random characters, separate from other secrets. Keep a copy outside Embarko.
# BACKUP_ENCRYPTION_KEY=""
# RESTORE_FROM=""        # backup filename to restore at next start (remove afterwards)
# RESTORE_ON_EMPTY="false"

# ── viaSocket automations — optional ────────────────────────────────────
# Daymark works fully without these. When set, admins get an Automations page.
# Server-side only: the embed secret must never reach the browser or be committed.
VIASOCKET_ORG_ID=""
VIASOCKET_PROJECT_ID=""
VIASOCKET_EMBED_SECRET=""
