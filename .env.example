# ── Database (PostgreSQL) ───────────────────────────────────────────────
# Pooled connection string used by the running app.
DATABASE_URL="postgresql://user:password@host:5432/daymark"
# Optional: direct (non-pooled) connection used only for `prisma migrate`.
# Needed on providers that front the database with a pooler (Neon, Supabase…).
# DIRECT_URL="postgresql://user:password@host:5432/daymark"

# ── Authentication (Better Auth) ────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public base URL of the app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (SMTP) — optional ─────────────────────────────────────────────
# Without SMTP, invitation links are shown to the admin to copy and send
# manually, and "Forgot password" reports that email is not configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Daymark <no-reply@example.com>"

# ── AI (used from Phase 3) ──────────────────────────────────────────────
# AI_PROVIDER="anthropic"   # anthropic | openai
# AI_MODEL=""
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
